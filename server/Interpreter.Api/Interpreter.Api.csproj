<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Interpreter.Core\Interpreter.Core.csproj" />
    <ProjectReference Include="..\Interpreter.Providers.Deepgram\Interpreter.Providers.Deepgram.csproj" />
    <ProjectReference Include="..\Interpreter.Providers.OpenAI\Interpreter.Providers.OpenAI.csproj" />
    <ProjectReference Include="..\Interpreter.Providers.Anthropic\Interpreter.Providers.Anthropic.csproj" />
    <ProjectReference Include="..\Interpreter.Providers.ElevenLabs\Interpreter.Providers.ElevenLabs.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Public demo image (T5, docs/GUARDRAILS.md G14), built by the SDK without a Docker daemon:
      (cd web && npm run build)
      dotnet publish server/Interpreter.Api -c Release -p:DemoImage=true /t:PublishContainer
    The built SPA and config/ go into the image; keys never do (they come from the task definition).
  -->
  <PropertyGroup Condition="'$(DemoImage)' == 'true'">
    <ContainerRepository>interpreter-demo</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
  </PropertyGroup>
  <ItemGroup Condition="'$(DemoImage)' == 'true'">
    <Content Include="..\..\web\dist\**\*" LinkBase="spa" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\config\*.json" LinkBase="config" CopyToPublishDirectory="PreserveNewest" />
    <ContainerEnvironmentVariable Include="Languages__Path" Value="/app/config/languages.json" />
    <ContainerEnvironmentVariable Include="Demo__SpaPath" Value="/app/spa" />
    <ContainerEnvironmentVariable Include="Demo__NoIndex" Value="true" />
    <ContainerEnvironmentVariable Include="Demo__ForwardLimit" Value="2" />
  </ItemGroup>

</Project>
