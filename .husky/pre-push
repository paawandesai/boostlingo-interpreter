# Budget < 60 s. Mirrors the CI required checks that are cheap enough to run locally.
set -e
(cd web && npx tsc -b --noEmit && npx vitest run --changed origin/main --passWithNoTests)
dotnet build server -m:2 --nologo -v q
dotnet test --solution server/Interpreter.slnx --no-build --filter-not-trait "Category=Live"
