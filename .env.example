# Copy to .env (git-ignored) or export in your shell. Placeholders only: never commit real values.
# The server reads these; none of them may reach the browser bundle.
# Shared demo token the browser must send before the server spends provider credit.
# Pick any long random string; type the same value into the setup screen.
DEMO_ACCESS_TOKEN=replace-me
OPENAI_API_KEY=replace-me
DEEPGRAM_API_KEY=replace-me
# Claude translator. ANTHROPIC_API_KEY is read as a fallback, but Claude Code cloud
# environments reserve that name, so use this one there.
CLAUDE_TRANSLATOR_API_KEY=replace-me
# Paid ElevenLabs plan only (docs/GUARDRAILS.md): the free plan is non-commercial.
ELEVENLABS_API_KEY=replace-me
