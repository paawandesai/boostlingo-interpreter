# Copy to .env (git-ignored) or export in your shell. Placeholders only: never commit real values.
# The server reads these; none of them may reach the browser bundle.
# Shared demo token the browser must send before the server spends provider credit.
# Pick any long random string; type the same value into the setup screen.
DEMO_ACCESS_TOKEN=replace-me
OPENAI_API_KEY=replace-me
# Deepgram STT only. Leave it commented and cascade uses OpenAI transcription, the setup the published
# numbers use (Deepgram's terms bar benchmarking without consent).
# DEEPGRAM_API_KEY=replace-me
# Claude translator. ANTHROPIC_API_KEY is read as a fallback, but Claude Code cloud
# environments reserve that name, so use this one there.
# Only with Cascade__Translator=anthropic.
# CLAUDE_TRANSLATOR_API_KEY=replace-me
# Paid ElevenLabs plan only (docs/GUARDRAILS.md): the free plan is non-commercial.
ELEVENLABS_API_KEY=replace-me
# Non-secret switches, shown here so the keys have one reference. Leave them commented to keep the defaults.
# Cascade STT adapter: deepgram (default) or openai. The public demo and the published numbers use openai.
# Cascade__Stt=openai
# Cascade translator: openai (default) or anthropic. A client may also pick either per session.
# Cascade__Translator=anthropic
# Cascade TTS adapter: elevenlabs (default) or openai (/v1/audio/speech; the TTS BAA mode allows).
# Cascade__Tts=openai
# BAA mode (README "BAA mode"): off by default. Turn it on only with executed BAAs, and list each covered vendor.
# Compliance__RequireBaa=true
# Compliance__BaaSigned__0=openai
# Compliance__BaaSigned__1=anthropic
# Realtime model: gpt-realtime-2.1 (default) or the brief's deprecated gpt-realtime; both stay selectable in the setup screen.
# OpenAI__Realtime__Model=gpt-realtime
# Cascade OpenAI STT model: gpt-realtime-whisper (default) or the gpt-4o-transcribe fallback (README, Known constraints).
# OpenAI__Transcription__Model=gpt-4o-transcribe
# Session mints and cascade upgrades allowed per client address per minute (default 10).
# Access__PermitLimit=10
# Cascade flush policy (D11): when translated text is sent to TTS. Defaults shown.
# Cascade__Flush__MinClauseChars=30
# Cascade__Flush__MaxWaitMs=400
# Cascade__Flush__MinCharsOnTimeout=12
